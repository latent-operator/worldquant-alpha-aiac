[importlinter]
root_package = backend
include_external_packages = True

[importlinter:contract:request-policy]
name = Request evidence policy has no runtime dependencies
type = forbidden
source_modules = backend.services.request_lifecycle
forbidden_modules =
    backend.database
    backend.models
    backend.adapters
    backend.agents
    sqlalchemy
    httpx
    requests
    aiohttp

[importlinter:contract:release-boundary]
name = Release boundary has no direct request-runner or Agent imports
type = forbidden
source_modules = backend.services.ppa_handoff
forbidden_modules =
    backend.services.theme_ppa_v2
    backend.agents
allow_indirect_imports = True

[importlinter:contract:quality-policy]
name = Alpha quality policy has no runtime dependencies
type = forbidden
source_modules = backend.services.alpha_quality_policy
forbidden_modules =
    backend.database
    backend.models
    backend.config
    backend.adapters
    backend.agents
    sqlalchemy
    httpx
    requests
    aiohttp

[importlinter:contract:quality-consumers]
name = Research quality consumers do not construct MiningAgent
type = forbidden
source_modules =
    backend.services.alpha_quality_evaluation
    backend.services.theme_ppa
    backend.services.theme_ppa_v2
    backend.services.paper_experiment
    backend.evals.live_runner
    backend.evals.discovery_campaign
forbidden_modules = backend.agents.mining_agent
